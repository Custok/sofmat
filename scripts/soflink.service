# /etc/systemd/system/soflink.service — tal cual corre en el nodo main (.63). Rutas y usuario son marcadores: ajústalos a tu instalación.
# Referencia para otros nodos: rutas y User son de .63. En .100 (el operador del nodo edge)
# va como unidad de USUARIO (~/.config/systemd/user/), igual que su ComfyUI.
#
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
# soflink (coordinador sofmat) en node-d .63 — el operador del nodo main, 2026-09-07.
# Motivo (topic prefill-decode-desagregado-kv-handoff, 06-09 23:38): soflink se
# lanzaba con `setsid nohup` desde levantar.sh, así que NO sobrevivía a un
# reinicio del host. Le pasó a .51 tras su reboot de las 23:19: su soflink no
# volvió, el `kv-fetch` del traspaso murió con "connection refused" y la
# petición de 46k pagó prefill + decode entera (57 s). El autoupdate sí aplica
# en caliente (re-exec desde la v202609062130); lo que faltaba era esto.
Description=soflink — coordinador sofmat en node-d (.63), API y /kv del KV-handoff
Documentation=https://github.com/Custok/sofmat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soflink
WorkingDirectory=/opt/soflink
# Integridad ANTES de arrancar: el AppImage debe ser un asset oficial de las
# releases de GitHub (mismo script que usa el arranque manual de levantar.sh).
# Si no cuadra, la unidad no arranca (binario re-etiquetado = no se ejecuta).
ExecStartPre=/opt/soflink/verificar-appimage.sh
ExecStart=/opt/soflink/soflink-x86_64.AppImage serve -no-update --config config.local.json
Restart=always
RestartSec=5
# 2026-09-09 (orden de David): `-no-update`. El autoupdate integrado entro en
# bucle porque 14 releases del 07-09 publicaron el MISMO artefacto (declara
# 202609071545): comparaba, descargaba, se reiniciaba y volvia a comparar lo
# mismo. 272 reinicios, ~940 MB y 51 API keys rotadas en 24 h, sin una sola
# linea de error. La actualizacion ahora es DELIBERADA: ./actualizar-soflink.sh
# (verifica hash Y que el artefacto declare la version de su etiqueta).
StandardOutput=append:/opt/soflink/soflink.log
StandardError=append:/opt/soflink/soflink.log

[Install]
WantedBy=multi-user.target

# ─────────────────────────────────────────────────────────────────────────────
