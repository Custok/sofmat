+
+    // Host-side per-seq state for a cross-process slot handoff (server slot save/restore):
+    // the carryover row h_p that process() pairs with the next token. The draft KV itself
+    // travels through llama_state_seq_get_data(ctx_dft); without this row the first MTP
+    // position after a restore would be paired with a stale h of a previous request.
+    bool get_state(llama_seq_id seq_id, std::vector<uint8_t> & data) const override {
+        if (seq_id < 0 || seq_id >= (llama_seq_id) n_seq) {
+            return false;
+        }
+
+        const auto & h = pending_h[seq_id];
+
+        data.resize(h.size() * sizeof(float));
+        std::memcpy(data.data(), h.data(), data.size());
+
+        return true;
+    }
+
+    void set_state(llama_seq_id seq_id, const std::vector<uint8_t> & data) override {
+        if (seq_id < 0 || seq_id >= (llama_seq_id) n_seq) {
+            return;
+        }
+        if (data.size() != (size_t) n_embd * sizeof(float)) {
+            return;
+        }
+
+        pending_h[seq_id].resize(n_embd);
+        std::memcpy(pending_h[seq_id].data(), data.data(), data.size());
+    }
 };
 
