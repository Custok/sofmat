+    // Sidecar for a cross-process slot handoff. The slot save file only carries ctx_tgt;
+    // with a draft model / MTP head the draft context (ctx_dft) has its own KV for the
+    // sequence, and a restore in ANOTHER process would draft cold (measured on a 27B MTP
+    // model: acceptance 60% -> 17%, generation halved). The in-memory prompt cache already
+    // keeps both states (prompt_save/prompt_load); this does the same on disk, in a
+    // separate file so the main file stays readable by older builds.
+    //
+    // Layout: "LLDFT001" | u64 n_dft | ctx_dft seq state | u64 n_spc | speculative per-seq state
+    static constexpr const char * DFT_FILE_MAGIC = "LLDFT001";
+
+    size_t dft_save(const std::string & path) const {
+        if (!ctx_dft) {
+            return 0;
+        }
+
+        const size_t n_dft = llama_state_seq_get_size_ext(ctx_dft, id, LLAMA_STATE_SEQ_FLAGS_NONE);
+
+        std::vector<uint8_t> buf(n_dft);
+        if (n_dft > 0) {
+            const size_t n = llama_state_seq_get_data_ext(ctx_dft, buf.data(), n_dft, id, LLAMA_STATE_SEQ_FLAGS_NONE);
+            if (n != n_dft) {
+                SLT_WRN(*this, "draft state size mismatch (%zu != %zu), sidecar not written\n", n, n_dft);
+                return 0;
+            }
+        }
+
+        std::vector<uint8_t> spc;
+        if (spec) {
+            common_speculative_get_state(spec, id, spc);
+        }
+
+        std::ofstream f(path, std::ios::binary);
+        if (!f) {
+            SLT_WRN(*this, "cannot write draft state file %s\n", path.c_str());
+            return 0;
+        }
+
+        const uint64_t sz_dft = n_dft;
+        const uint64_t sz_spc = spc.size();
+
+        f.write(DFT_FILE_MAGIC, 8);
+        f.write((const char *) &sz_dft, sizeof(sz_dft));
+        if (n_dft > 0) {
+            f.write((const char *) buf.data(), n_dft);
+        }
+        f.write((const char *) &sz_spc, sizeof(sz_spc));
+        if (!spc.empty()) {
+            f.write((const char *) spc.data(), spc.size());
+        }
+
+        if (!f) {
+            SLT_WRN(*this, "error writing draft state file %s\n", path.c_str());
+            return 0;
+        }
+
+        SLT_TRC(*this, "draft state saved to %s (%zu + %zu bytes)\n", path.c_str(), n_dft, spc.size());
+
+        return 8 + 2 * sizeof(uint64_t) + n_dft + spc.size();
+    }
+
+    size_t dft_load(const std::string & path) {
+        if (!ctx_dft) {
+            return 0;
+        }
+
+        std::ifstream f(path, std::ios::binary);
+        if (!f) {
+            SLT_WRN(*this, "no draft state file %s - the draft starts cold for this sequence\n", path.c_str());
+            return 0;
+        }
+
+        char magic[8];
+        f.read(magic, sizeof(magic));
+        if (!f || std::memcmp(magic, DFT_FILE_MAGIC, sizeof(magic)) != 0) {
+            SLT_WRN(*this, "invalid draft state file %s (bad magic)\n", path.c_str());
+            return 0;
+        }
+
+        uint64_t sz_dft = 0;
+        f.read((char *) &sz_dft, sizeof(sz_dft));
+        std::vector<uint8_t> buf(sz_dft);
+        if (sz_dft > 0) {
+            f.read((char *) buf.data(), sz_dft);
+        }
+
+        uint64_t sz_spc = 0;
+        f.read((char *) &sz_spc, sizeof(sz_spc));
+        std::vector<uint8_t> spc(sz_spc);
+        if (sz_spc > 0) {
+            f.read((char *) spc.data(), sz_spc);
+        }
+
+        if (!f) {
+            SLT_WRN(*this, "truncated draft state file %s\n", path.c_str());
+            return 0;
+        }
+
+        // start from an empty draft sequence, whatever this slot held before
+        llama_memory_seq_rm(llama_get_memory(ctx_dft), id, -1, -1);
+
+        if (sz_dft > 0) {
+            const size_t n = llama_state_seq_set_data_ext(ctx_dft, buf.data(), sz_dft, id, LLAMA_STATE_SEQ_FLAGS_NONE);
+            if (n != sz_dft) {
+                SLT_WRN(*this, "failed to restore draft state (%zu of %zu bytes)\n", n, (size_t) sz_dft);
+                llama_memory_seq_rm(llama_get_memory(ctx_dft), id, -1, -1);
+                return 0;
+            }
+        }
+
+        if (spec && sz_spc > 0) {
+            common_speculative_set_state(spec, id, spc);
+        }
+
+        SLT_TRC(*this, "draft state restored from %s (%zu + %zu bytes)\n", path.c_str(), (size_t) sz_dft, (size_t) sz_spc);
+
+        return 8 + 2 * sizeof(uint64_t) + sz_dft + sz_spc;
+    }
